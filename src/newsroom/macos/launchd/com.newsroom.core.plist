<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.newsroom.core</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>@ROOT@/main.py</string>
    <string>run</string>
    <string>--poll</string>
  </array>
  <key>WorkingDirectory</key><string>@ROOT@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>NEWSROOM_ROOT</key><string>@ROOT@</string>
  </dict>
  <key>Nice</key><integer>15</integer>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>@LOGS@/core.out.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/core.err.log</string>
</dict>
</plist>
