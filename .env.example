# Copy to .env — never commit real values (§77).

# --- LLM ---
NEWSROOM_LLM_BASE_URL=http://localhost:11434

# --- Publishing / streaming (Phase 12+, unused until then) ---
# YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
# YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx

# --- Optional overrides ---
# NEWSROOM_CONFIG_DIR=/absolute/path/to/config
# NEWSROOM_DB=/absolute/path/to/newsroom.db

# --- Source API keys (env-gated; services load this file via main.py) ---
# FRED_API_KEY=           # fredaccount.stlouisfed.org/apikeys
# BLS_API_KEY=            # data.bls.gov/registrationEngine (optional; unkeyed=25/day)
# ACLED_API_KEY=          # developer.acleddata.com
# ACLED_EMAIL=            # account email
# NEWSROOM_RTMP_URL=      # rtmp://.../key — gates outputs.rtmp when enabled
